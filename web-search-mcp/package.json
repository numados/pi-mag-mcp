    "test": "npm run build && node --test --test-concurrency=4 tests/*.test.mjs",
    "smoke": "node tests/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "duck-duck-scrape": "2.2.7",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
