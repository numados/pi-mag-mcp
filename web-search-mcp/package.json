{
  "name": "web-search-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web search MCP server for Pi: web_search tool, DuckDuckGo free path by default, Tavily deep mode behind explicit quota approval; structured results with provenance and honest failure statuses",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
